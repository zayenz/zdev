---
interface Props {
  metadata: { title: string; area: string; date: string; revision: string; scope: string; status: string; };
  headings: { slug: string; text: string; }[];
}
const { metadata, headings } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="data:," />
    <title>{metadata.title} · {metadata.date}</title>
  </head>
  <body>
    <a class="skip" href="#report">Skip to report</a>
    <aside class="sidebar" aria-label="Report navigation">
      <div class="brand">Zdev / {metadata.area}</div>
      <p class="edition">Engineering report<br />{metadata.date}</p>
      <nav>{headings.map((heading, index) => (
        <a href={`#${heading.slug}`}><span>{String(index + 1).padStart(2, '0')}</span>{heading.text}</a>
      ))}</nav>
      <button class="print" type="button" onclick="window.print()">Print / save as PDF</button>
      <p class="note">Self-contained reading copy.<br />Source links may require the repository or network.</p>
    </aside>
    <main id="report">
      <header>
        <div class="eyebrow">{metadata.area} · {metadata.date}</div>
        <h1>{metadata.title}</h1>
        {metadata.status === 'draft' && <p class="draft">Draft. Writing and evidence review are not complete.</p>}
        <div class="meta"><p>Reviewed source: <code>{metadata.revision}</code></p><p>{metadata.scope}</p></div>
      </header>
      <article><slot /></article>
    </main>
  </body>
</html>
<style is:global>
  :root { --paper:#f6f3ec; --ink:#202c32; --muted:#57666b; --rule:#d8dcd5; --accent:#9d422a; --blue:#254d69; --panel:#fffdf8; --nav:#192f36; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; scroll-padding-top:2rem; }
  body { margin:0; background:var(--paper); color:var(--ink); font:17px/1.65 Charter,"Bitstream Charter",Georgia,serif; }
  a { color:var(--blue); text-underline-offset:3px; overflow-wrap:anywhere; }
  a:hover { color:var(--accent); }
  :focus-visible { outline:3px solid var(--accent); outline-offset:4px; }
  .skip { position:fixed; top:-100px; left:10px; z-index:2; background:white; padding:10px; }
  .skip:focus { top:10px; }
  .sidebar { position:fixed; inset:0 auto 0 0; width:260px; padding:30px 24px; overflow-y:auto; background:var(--nav); color:#f4f0e6; font:13px/1.5 "Avenir Next",Avenir,"Segoe UI",sans-serif; }
  .brand { font-size:19px; letter-spacing:.06em; }
  .edition,.note { color:#b7c8c7; font-size:12px; }
  nav a { display:block; padding:8px 0; border-bottom:1px solid #ffffff12; color:#d9e4df; text-decoration:none; }
  nav a:hover { color:#ffd3ae; }
  nav a span { display:inline-block; width:25px; color:#90aaa9; font-size:11px; }
  .print { margin:20px 0 8px; padding:9px 13px; background:transparent; border:1px solid #819c9b; border-radius:3px; color:#ecf1e9; cursor:pointer; font:inherit; }
  main { max-width:1260px; margin-left:260px; padding:60px 6vw 90px; min-width:0; }
  .eyebrow,.meta,th,figcaption,.draft { font-family:"Avenir Next",Avenir,"Segoe UI",sans-serif; }
  .eyebrow { color:var(--accent); font-size:12px; letter-spacing:.1em; font-weight:700; }
  h1 { font-size:clamp(38px,5vw,64px); line-height:1.08; letter-spacing:-.03em; font-weight:500; margin:18px 0 28px; }
  h2 { border-top:1px solid var(--rule); margin:48px 0 23px; padding-top:38px; font-size:31px; line-height:1.25; letter-spacing:-.02em; font-weight:500; }
  h3 { font-size:23px; line-height:1.3; font-weight:500; margin:30px 0 14px; }
  p { margin:0 0 17px; }
  .meta { border-top:1px solid var(--rule); padding-top:17px; color:var(--muted); font-size:12px; overflow-wrap:anywhere; }
  .meta p { margin:0 0 6px; }
  .draft,.callout,blockquote { padding:18px 22px; border-left:4px solid var(--accent); background:#eee7dc; }
  .draft { font-size:14px; }
  blockquote { margin:24px 0; }
  blockquote p:last-child,.callout p:last-child { margin:0; }
  code { font:13px/1.5 "SFMono-Regular",Consolas,monospace; background:#e8eae3; padding:2px 4px; border-radius:2px; overflow-wrap:anywhere; }
  pre { overflow-x:auto; padding:22px; background:#203139; color:#e5eee5; border-radius:3px; }
  pre code { padding:0; color:inherit; background:none; overflow-wrap:normal; }
  .table-wrap { overflow-x:auto; margin:22px 0; }
  table { width:100%; border-collapse:collapse; font-size:15px; line-height:1.5; }
  caption { text-align:left; font-weight:600; margin-bottom:10px; }
  th { text-align:left; color:var(--muted); background:#eceee7; border-top:2px solid var(--ink); font-size:12px; }
  th,td { padding:12px 11px; vertical-align:top; border-bottom:1px solid var(--rule); }
  tbody tr:nth-child(even) { background:#ffffff45; }
  li { margin:8px 0; }
  figure { margin:25px 0; }
  img,svg { max-width:100%; height:auto; }
  figcaption,.small,.source { font-size:13px; color:var(--muted); }
  details { padding:15px 0; border-top:1px solid var(--rule); }
  summary { cursor:pointer; font-weight:600; }
  details[open] summary { margin-bottom:16px; }
  @media(max-width:1000px) { .sidebar { position:relative; width:auto; padding:22px; } nav { display:grid; grid-template-columns:1fr 1fr; gap:0 22px; } .sidebar .note,.sidebar .print { display:none; } main { margin-left:0; padding:38px 6vw 60px; } }
  @media(max-width:580px) { body { font-size:16px; } h1 { font-size:40px; } h2 { font-size:28px; } nav { font-size:12px; } th,td { min-width:125px; padding:10px 8px; } }
  @media(prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } }
  @media print { body { background:white; color:#111; font-size:10.5pt; } .sidebar,.skip { display:none; } main { margin:0; padding:0; max-width:none; } h1 { font-size:34pt; } h2 { font-size:22pt; margin-top:24px; padding-top:24px; } h2,h3 { break-after:avoid; } pre { white-space:pre-wrap; background:#eee; color:#111; } .table-wrap { overflow:visible; } table { font-size:9pt; } th,td { min-width:0; } a { color:inherit; } }
</style>
